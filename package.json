{
  "name": "college-result-management-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first, offline-capable result management for Bangladeshi schools and colleges (Phase 1 foundation).",
  "scripts": {
    "dev": "node api.js && vite",
    "build": "node api.js && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.js\"",
    "validate:flags": "node scripts/validate-feature-flags.mjs config/feature-flags.json",
    "test:e2e": "bash tests/e2e/serve_and_run.sh"
  },
  "dependencies": {
    "@fontsource/anek-bangla": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/atma": "^5.3.0",
    "@fontsource/baloo-da-2": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/galada": "^5.3.0",
    "@fontsource/google-sans": "^5.3.2",
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/mina": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/noto-serif-bengali": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/tinos": "^5.3.0",
    "@fontsource/tiro-bangla": "^5.3.0",
    "firebase": "^10.14.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
