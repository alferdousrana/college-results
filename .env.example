# Copy to .env.local for development. Configure the same keys in Vercel → Project → Environment Variables.
# Firebase web config values are identifiers, not secrets; access is protected by Firestore Security Rules.
# NEVER put service-account JSON, private keys or GitHub tokens in any VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase App Check (reCAPTCHA v3/Enterprise site key) to reduce automated result scraping.
VITE_APPCHECK_SITE_KEY=

# Optional: connect to local emulators in development ("true" to enable).
VITE_USE_EMULATORS=false
